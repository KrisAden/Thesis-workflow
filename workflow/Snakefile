# workflow/Snakefile
import os, sys, yaml
from pathlib import Path
from snakemake.shell import shell

ROOT = Path.cwd()
SRC  = ROOT / "src"
PYTHON = sys.executable
CFG = ROOT / "config/config.yaml"

# OS-aware runner; pass module name per rule
if os.name == "nt":
    shell.executable("powershell")
    RUN = lambda module: f'& "{PYTHON}" -m {module} --config "{CFG}"'
else:
    shell.executable("/bin/bash")
    RUN = lambda module: f'PYTHONPATH="{SRC}" "{PYTHON}" -m {module} --config "{CFG}"'

# reduction levels
import yaml
with open("config/config.yaml") as _f:
    _cfg = yaml.safe_load(_f)
REDUCTIONS = _cfg.get("parameters", {}).get("co2_reductions", [0])

BYPASS_RESCALE = _cfg.get("parameters", {}).get("preprocess", {}).get("bypass", False)

# Plotting configuration
PLOTTING_ENABLED = _cfg.get("parameters", {}).get("plotting", {}).get("enable", False)
PLOT_TYPES = {k: v for k, v in _cfg.get("parameters", {}).get("plotting", {}).get("plot_types", {}).items() if v}
OUTPUT_FORMATS = _cfg.get("parameters", {}).get("plotting", {}).get("output_formats", ["png"])

# Convenience: split baseline (0) vs constrained (>0)
REDUC_GT0 = [r for r in REDUCTIONS if float(r) > 0]
HAS_BASELINE = any(float(r) == 0 for r in REDUCTIONS)

rule all:
    input:
        "data/interim/network_rescaled.nc",
        "data/interim/network_costed.nc",
        "data/interim/network_costed_tx.nc",
        "data/interim/network_costed_tx_gen.nc",
        "data/interim/network_costed_tx_gen_sto.nc",   # add this
        "results/tables/load_scaling.csv",
        "results/tables/tx_expansion_bounds.csv",
        "results/tables/gen_expansion_bounds.csv",
        "results/tables/generator_capital_costs.csv",
        *(["results/networks/solved_baseline_costed_expansion.nc",
           "results/tables/solve_baseline_costed_expansion.csv",
           "results/tables/baseline_emissions.csv"] if HAS_BASELINE else []),
        expand("results/networks/solved_reduction_{r}.nc", r=REDUC_GT0),
        expand("results/tables/solve_reduction_{r}.csv", r=REDUC_GT0),
        *([expand("results/plots/{plot_type}.{fmt}", 
                  plot_type=list(PLOT_TYPES.keys()), 
                  fmt=OUTPUT_FORMATS)] if PLOTTING_ENABLED else [])


if BYPASS_RESCALE:
    # Copy base -> "rescaled" and write a dummy scaling table
    rule rescale_loads:
        input:
            lambda wc: _cfg["paths"]["base_network"]
        output:
            "data/interim/network_rescaled.nc",
            "results/tables/load_scaling.csv"
        shell:
            # copy the base network to the expected rescaled path
            'cp {input} {output[0]} && echo "bus,scale\nALL,1.0" > {output[1]}'
else:
    rule rescale_loads:
        output:
            "data/interim/network_rescaled.nc",
            "results/tables/load_scaling.csv"
        shell:
            RUN("pypsa_thesis.preprocess")

rule apply_costs:
    input:
        "data/interim/network_rescaled.nc",
        "data/raw/generator_costs.csv"
    output:
        "data/interim/network_costed.nc",
        "results/tables/generator_capital_costs.csv"
    shell:
        RUN("pypsa_thesis.apply_costs --network-in {input[0]} --network-out {output[0]} --table-out {output[1]}")

rule enable_transmission_expansion:
    input:
        "data/interim/network_costed.nc"
    output:
        network="data/interim/network_costed_tx.nc",
        bounds="results/tables/tx_expansion_bounds.csv",
        viol="results/tables/tx_bound_violations.csv"
    shell:
        RUN('pypsa_thesis.apply_transmissionexpansion '
            '--network-in {input} '
            '--network-out {output.network} '
            '--report-out {output.bounds} '
            '--violations-out {output.viol}')


rule enable_generator_expansion:
    input:
        "data/interim/network_costed_tx.nc"
    output:
        network = "data/interim/network_costed_tx_gen.nc",
        bounds  = "results/tables/gen_expansion_bounds.csv",
        viol    = "results/tables/gen_bounds_violations.csv"
    shell:
        RUN('pypsa_thesis.apply_generatorexpansion '
            '--network-in {input} '
            '--network-out {output.network} '
            '--report-out {output.bounds} '
            '--violations-out {output.viol}')


rule add_storage:
    input:
        "data/interim/network_costed_tx_gen.nc",
        "data/raw/storage_costs.csv"
    output:
        "data/interim/network_costed_tx_gen_sto.nc",
        "results/tables/storage_costs_applied.csv"
    shell:
        RUN("pypsa_thesis.apply_storage --network-in {input[0]} --network-out {output[0]} --table-out {output[1]}")



rule solve_baseline:
    input:
        base="data/interim/network_costed_tx_gen_sto.nc"
    output:
        net="results/networks/solved_baseline_costed_expansion.nc",
        report="results/tables/solve_baseline_costed_expansion.csv",
        emissions="results/tables/baseline_emissions.csv"
    shell:
        RUN('pypsa_thesis.solve '
            '--network-in {input.base} '
            '--network-out {output.net} '
            '--report-out {output.report} '
            '--write-baseline {output.emissions}')


rule solve_with_cap:
    input:
        base="data/interim/network_costed_tx_gen_sto.nc",
        baseline="results/tables/baseline_emissions.csv"
    output:
        net="results/networks/solved_reduction_{r}.nc",
        report="results/tables/solve_reduction_{r}.csv"
    params:
        reduction="{r}"
    shell:
        RUN('pypsa_thesis.solve '
            '--network-in {input.base} '
            '--network-out {output.net} '
            '--report-out {output.report} '
            '--reduction {params.reduction} '
            '--baseline-file {input.baseline}')


rule make_plots:
    input:
        # Always include reduction networks and tables
        reduction_nets=expand("results/networks/solved_reduction_{r}.nc", r=REDUC_GT0),
        reduction_tables=expand("results/tables/solve_reduction_{r}.csv", r=REDUC_GT0),
        bounds_tables=[
            "results/tables/tx_expansion_bounds.csv",
            "results/tables/gen_expansion_bounds.csv"
        ],
        # Conditionally include baseline files
        baseline_files=(["results/networks/solved_baseline_costed_expansion.nc",
                        "results/tables/solve_baseline_costed_expansion.csv"] if HAS_BASELINE else [])
    output:
        expand("results/plots/{plot_type}.{fmt}", 
               plot_type=list(PLOT_TYPES.keys()), 
               fmt=OUTPUT_FORMATS)
    params:
        plot_types=lambda wc: ",".join(PLOT_TYPES.keys()),
        output_formats=lambda wc: ",".join(OUTPUT_FORMATS),
        has_baseline=HAS_BASELINE
    shell:
        RUN('pypsa_thesis.plotting '
            '--plot-types {params.plot_types} '
            '--output-dir results/plots '
            '--output-formats {params.output_formats} '
            '--has-baseline {params.has_baseline}')
